# Stellis server connects to OpenClaw inside NemoClaw on Nebius Cloud.
STELLIS_RUNTIME_PROFILE=cloud
STELLIS_ACCOUNT_ID=1
STELLIS_AGENT_GATEWAY_ACCOUNT_ID=1
STELLIS_DATA_DIR=/var/lib/stellis-cloud
STELLIS_AGENT_GATEWAY_URL=
# Inject from a secret store; never commit a value here.
STELLIS_AGENT_GATEWAY_TOKEN=
NEBIUS_API_KEY=
# Set only after verifying cloud-side Tavily tool registration.
STELLIS_AGENT_GATEWAY_TAVILY_READY=0
