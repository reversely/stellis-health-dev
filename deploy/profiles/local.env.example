# GN100 only. Use an isolated data root and a separately configured local-inference sandbox.
STELLIS_RUNTIME_PROFILE=local
STELLIS_ACCOUNT_ID=1
STELLIS_DATA_DIR=/home/springbuilt/stellis-local-data
NEMOCLAW_GATEWAY_PORT=8990
STELLIS_NEMOCLAW_SANDBOX=stellis-local
STELLIS_NEMOCLAW_COMMAND=/home/springbuilt/.local/bin/nemoclaw
STELLIS_LOCAL_INFERENCE_URL=http://127.0.0.1:11434/v1
STELLIS_LOCAL_INFERENCE_MODEL=nemotron-3-nano:latest
# Set to 1 only after verifying the local sandbox's Tavily MCP provider.
STELLIS_TAVILY_MCP_READY=0

# Reuse installed GN100 speech assets; no model copies in this checkout.
STELLIS_AUDIO_WORKER=/home/springbuilt/.local/bin/stellis-audio-worker
STELLIS_ONLINE_ASR_MODEL_DIR=/home/springbuilt/stellis-models/live-asr/sherpa-onnx-nemo-parakeet-unified-en-0.6b-int8-streaming-560ms
STELLIS_PARAKEET_MODEL_DIR=/home/springbuilt/stellis-models/live-asr/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
STELLIS_WHISPER_MODEL=/home/springbuilt/stellis-data/models/ggml-small.en.bin
STELLIS_SEGMENTATION_MODEL=/home/springbuilt/stellis-data/models/pyannote-segmentation-3.0-int8.onnx
STELLIS_EMBEDDING_MODEL=/home/springbuilt/stellis-data/models/nemo-en-titanet-small.onnx
