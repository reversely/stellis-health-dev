# GN100 only. Use an isolated data root and a separately configured local-inference sandbox.
STELLIS_RUNTIME_PROFILE=local
STELLIS_ACCOUNT_ID=1
STELLIS_DATA_DIR=/home/springbuilt/stellis-local-data
NEMOCLAW_GATEWAY_PORT=8990
STELLIS_NEMOCLAW_SANDBOX=stellis-local
STELLIS_NEMOCLAW_COMMAND=/home/springbuilt/.local/bin/nemoclaw
STELLIS_LOCAL_INFERENCE_URL=http://127.0.0.1:11434/v1
STELLIS_LOCAL_INFERENCE_MODEL=nemotron-3-nano:latest
# Set to 1 only after verifying the local sandbox's Tavily MCP provider.
STELLIS_TAVILY_MCP_READY=0
